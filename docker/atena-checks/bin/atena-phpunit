#!/usr/bin/env bash
# Executa a suíte PHPUnit criada no repositório. Sem suíte => exit 127 (check indisponível).
set -uo pipefail
if [ -f phpunit.xml ] || [ -f phpunit.xml.dist ]; then
  exec phpunit --do-not-cache-result --colors=never
elif [ -d tests ]; then
  exec phpunit --do-not-cache-result --colors=never tests
fi
echo "Nenhuma suíte PHPUnit encontrada (phpunit.xml ou tests/)."
exit 127
