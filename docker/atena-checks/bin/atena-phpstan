#!/usr/bin/env bash
# Análise estática nível 0 sobre o código próprio. Usa phpstan.neon do repo quando existir.
set -uo pipefail
if [ -f phpstan.neon ] || [ -f phpstan.neon.dist ]; then
  exec phpstan analyse --no-progress --memory-limit=1G --error-format=raw
fi
paths=()
for p in Controller Models Views/mainviw.php Views/pages src app tests index.php config.php gerar-pdf.php; do
  [ -e "$p" ] && paths+=("$p")
done
autoload=()
[ -f Lib/vendor/autoload.php ] && autoload=(--autoload-file=Lib/vendor/autoload.php)
[ -f vendor/autoload.php ] && autoload=(--autoload-file=vendor/autoload.php)
exec phpstan analyse --no-progress --memory-limit=1G --error-format=raw --level=0 "${autoload[@]}" "${paths[@]}"
